@page "/{{ class_name | lower }}/edit/{Id:{{ pk_type | lower }}}"
@inject I{{ class_name }}Service {{ class_name }}Service
@inject NavigationManager NavigationManager

<h3>{{ class_name }} - Modifica</h3>

@if (model == null)
{
    <p><em>Caricamento in corso...</em></p>
}
else
{
    <EditForm Model="model" OnValidSubmit="HandleSubmit">
        <DataAnnotationsValidator />
        <ValidationSummary />

{% for field in form_fields %}
        <div class="form-group">
            <label for="{{ field.prop_name }}">{{ field.label }}</label>
{% if field.is_bool %}
            <{{ field.input_component }} id="{{ field.prop_name }}" @bind-Value="model.{{ field.prop_name }}" class="form-check-input" />
{% else %}
            <{{ field.input_component }} id="{{ field.prop_name }}" @bind-Value="model.{{ field.prop_name }}" class="form-control" />
{% endif %}
            <ValidationMessage For="@(() => model.{{ field.prop_name }})" />
        </div>
{% endfor %}

        <div class="page-actions">
            <button type="submit" class="btn btn-primary">Salva</button>
            <button type="button" class="btn btn-secondary" @onclick="GoBack">Annulla</button>
        </div>
    </EditForm>
}

@code {
    [Parameter]
    public {{ pk_type }} Id { get; set; }

    private {{ class_name }}? model;

    protected override async Task OnInitializedAsync()
    {
        model = await {{ class_name }}Service.GetByIdAsync(Id);
    }

    private async Task HandleSubmit()
    {
        if (model != null)
        {
            await {{ class_name }}Service.UpdateAsync(model);
            NavigationManager.NavigateTo("/{{ class_name | lower }}");
        }
    }

    private void GoBack()
    {
        NavigationManager.NavigateTo("/{{ class_name | lower }}");
    }
}
